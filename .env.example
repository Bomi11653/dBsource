# 网站地址（SEO / OG / sitemap）
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3003

# 维护模式（true 时前台访客看到维护提示页，/admin 不受影响）
NEXT_PUBLIC_MAINTENANCE_MODE=false
# NEXT_PUBLIC_MAINTENANCE_MESSAGE=我们正在进行系统升级与内容维护，部分页面可能暂时不可用。感谢您的理解。
# NEXT_PUBLIC_MAINTENANCE_EMAIL=
# NEXT_PUBLIC_MAINTENANCE_PHONE=
# NEXT_PUBLIC_MAINTENANCE_WHATSAPP=
# NEXT_PUBLIC_MAINTENANCE_WECHAT=

# Strapi CMS（手机预览上传大文件时，后台会自动把 localhost 换成当前局域网 IP 直传 Strapi）
CMS_URL=http://localhost:1337
NEXT_PUBLIC_CMS_URL=http://localhost:1337
NEXT_PUBLIC_USE_MOCK_DATA=false

# Strapi 管理 Token（仅服务端，用于后台读取询盘等私有数据）
# 在 Strapi 后台 Settings → API Tokens 创建 Full access 或自定义 Token
STRAPI_API_TOKEN=

# 简易后台口令（可选，留空则本地免登录）
ADMIN_TOKEN=

# 询盘 webhook（可选，企业微信/钉钉机器人 URL）
LEAD_WEBHOOK_URL=

# 访问统计（可选，填入 GA4 测量 ID，如 G-XXXXXXXX）
NEXT_PUBLIC_GA_ID=

# 图片域名白名单（逗号分隔，可选额外 CDN 域名）
# NEXT_PUBLIC_IMAGE_DOMAINS=cdn.example.com
# 仅当 CMS 域名可信时启用 SVG 远程图片
# NEXT_PUBLIC_ALLOW_CMS_SVG=true

# DeepSeek AI（智能顾问 /api/ai/chat）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_LIMIT=20
AI_CACHE_TTL_HOURS=24
