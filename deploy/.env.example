# ========== 域名（正式环境）==========
SITE_DOMAIN=www.dbsource-pro.com
CMS_DOMAIN=cms.dbsource-pro.com
NEXT_PUBLIC_SITE_URL=https://www.dbsource-pro.com
CMS_URL=http://127.0.0.1:1337
NEXT_PUBLIC_CMS_URL=https://cms.dbsource-pro.com
NEXT_PUBLIC_USE_MOCK_DATA=false

# ========== 网站后台 / Strapi ==========
# 内容后台登录密码（/admin/login）
ADMIN_TOKEN=change-me-strong-password
# 官网 ISR 缓存刷新（/api/revalidate）
REVALIDATE_SECRET=change-me-revalidate-secret
# Strapi 部署后在后台 Settings → API Tokens 创建 Full access，填到这里
STRAPI_API_TOKEN=

# ========== PostgreSQL ==========
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=change-me-db-password

# ========== Strapi 密钥（生产必须改！运行: openssl rand -base64 16）==========
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me

# ========== AI（顾问对话 + 后台中英互转 + PDF 参数识别；生产必配）==========
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DAILY_LIMIT=20
AI_CACHE_TTL_HOURS=24

# ========== 询盘通知（可选）==========
# LEAD_WEBHOOK_URL=
