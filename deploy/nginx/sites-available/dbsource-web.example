# ECS PM2 部署用 Nginx 示例（复制到 /etc/nginx/sites-available/dbsource）
# 启用：sudo ln -sf /etc/nginx/sites-available/dbsource /etc/nginx/sites-enabled/
#
# 重要：用 IP 访问时（如 http://47.119.181.44）必须设置 default_server，
# 否则 location /uploads/ 可能落在错误的 server 块里，请求会进 Next.js 返回 404。

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name www.dbsource-pro.com dbsource-pro.com _;

    client_max_body_size 50m;

    # 优先匹配：Strapi 媒体（可选；未配置时 Next /strapi-uploads rewrite 也能用）
    location /uploads/ {
        proxy_pass http://127.0.0.1:1337/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
