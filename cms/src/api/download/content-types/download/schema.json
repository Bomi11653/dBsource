{
  "kind": "collectionType",
  "collectionName": "downloads",
  "info": {
    "singularName": "download",
    "pluralName": "downloads",
    "displayName": "③ 下载 Download",
    "description": "官网 /downloads 下载中心 · Software & catalogs"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "nameZh": {
      "type": "string",
      "required": true
    },
    "nameEn": {
      "type": "string",
      "required": true
    },
    "size": {
      "type": "string"
    },
    "fileName": {
      "type": "string"
    },
    "fileUrl": {
      "type": "string",
      "required": true
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "type": {
      "type": "enumeration",
      "enum": ["software", "catalog"],
      "required": true
    },
    "subCategory": {
      "type": "string",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "version": {
      "type": "string"
    },
    "osType": {
      "type": "enumeration",
      "enum": ["windows", "mac", "cross-platform"]
    },
    "releasedAt": {
      "type": "date"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "descZh": {
      "type": "text"
    },
    "descEn": {
      "type": "text"
    },
    "market": {
      "type": "enumeration",
      "enum": ["cn", "global", "all"],
      "default": "all"
    }
  }
}
