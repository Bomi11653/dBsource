{
  "kind": "collectionType",
  "collectionName": "leads",
  "info": {
    "singularName": "lead",
    "pluralName": "leads",
    "displayName": "⑧ 询盘 Lead",
    "description": "联系表单提交 · Contact form submissions"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": { "type": "string", "required": true },
    "company": { "type": "string" },
    "email": { "type": "email" },
    "phone": { "type": "string" },
    "product": { "type": "string" },
    "intentScore": { "type": "decimal", "default": 0 },
    "intentTag": { "type": "string" },
    "language": { "type": "string" },
    "country": { "type": "string" },
    "market": {
      "type": "enumeration",
      "enum": ["cn", "global", "all"],
      "default": "all"
    },
    "utmSource": { "type": "string" },
    "utmMedium": { "type": "string" },
    "utmCampaign": { "type": "string" },
    "utmTerm": { "type": "string" },
    "utmContent": { "type": "string" },
    "landingPage": { "type": "string" },
    "referrer": { "type": "string" },
    "owner": { "type": "string" },
    "nextFollowUpAt": { "type": "datetime" },
    "lastContactedAt": { "type": "datetime" },
    "lostReason": { "type": "text" },
    "notes": { "type": "text" },
    "message": { "type": "text", "required": true },
    "status": {
      "type": "enumeration",
      "enum": ["new", "contacted", "quoted", "won", "invalid", "read", "qualified", "lost", "archived"],
      "default": "new"
    }
  }
}
